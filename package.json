{
  "name": "readmark",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run pdfjs-assets && concurrently -k -n api,web \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "npm run pdfjs-assets && vite build",
    "start": "npm run build && tsx src/server/main.ts",
    "desktop:bundle": "esbuild src/desktop/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/desktop/main.mjs",
    "desktop": "npm run build && npm run desktop:bundle && electron .",
    "desktop:package": "npm run build && npm run desktop:bundle && electron-builder --mac",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "pdfjs-assets": "tsx scripts/copy-pdfjs-assets.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.16",
    "pdfjs-dist": "6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "description": "Read PDFs, highlight, and export insights.",
  "main": "dist/desktop/main.mjs",
  "build": {
    "appId": "io.github.ccomkhj.readmark",
    "productName": "Readmark",
    "files": [
      "dist/client/**/*",
      "dist/desktop/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "dir"
      ],
      "identity": "-",
      "hardenedRuntime": false
    }
  }
}
